# --- Extraction model (required) ---
# Workspace-scoped key from https://console.anthropic.com/settings/keys
# An org-level key also works if you set ANTHROPIC_WORKSPACE_ID alongside it.
ANTHROPIC_API_KEY=

# Only needed when the key above is org-level rather than workspace-scoped.
# ANTHROPIC_WORKSPACE_ID=

# Optional model override. Defaults to claude-sonnet-5.
# PLANNER_MODEL=claude-sonnet-5

# --- Linear (required to create issues) ---
# linear.app -> Settings -> Security & access -> Personal API keys
LINEAR_API_KEY=

# Optional. Defaults to the first team the key can see.
# LINEAR_TEAM_ID=
