# --- Extraction model (required) ---
# Workspace-scoped key from https://console.anthropic.com/settings/keys
# An org-level key also works if you set ANTHROPIC_WORKSPACE_ID alongside it.
ANTHROPIC_API_KEY=

# Only needed when the key above is org-level rather than workspace-scoped.
# ANTHROPIC_WORKSPACE_ID=

# Optional model override. Defaults to claude-sonnet-5.
# PLANNER_MODEL=claude-sonnet-5

# --- Linear (required to create issues) ---
# linear.app -> Settings -> Security & access -> Personal API keys
LINEAR_API_KEY=

# Optional. Defaults to the first team the key can see.
# LINEAR_TEAM_ID=

# Optional. File every created issue under one project. This is the project's
# UUID, not the short id in its URL -- find it with the Linear API, or leave
# blank to file straight to the team backlog.
# LINEAR_PROJECT_ID=

# --- Slack (optional) ---
# api.slack.com/apps -> create an app -> OAuth & Permissions.
# Bot token scopes required: chat:write, chat:write.public
# Without chat:write.public the bot can only post to channels it was invited to.
SLACK_BOT_TOKEN=
# Channel name or id. QUOTE IT if you include the hash -- an unquoted # starts
# a comment in .env files, which silently blanks the value.
#   SLACK_CHANNEL="#team"   SLACK_CHANNEL=team   SLACK_CHANNEL=C0123ABC
SLACK_CHANNEL=

# --- Cal.com (optional) ---
# cal.com -> Settings -> Developer -> API keys. A plain key, no OAuth.
# Follow-up meetings the notes call for are booked against live availability.
CALCOM_API_KEY=
